{
  "name": "together-menu",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "description": "一餐两人 · 原生微信小程序与双人实时点菜服务",
  "scripts": {
    "build": "node scripts/build-cloudflare.js",
    "deploy": "node scripts/build-cloudflare.js && wrangler deploy",
    "dev:cloudflare": "node scripts/build-cloudflare.js && wrangler dev",
    "check:cloudflare": "node scripts/build-cloudflare.js && wrangler deploy --dry-run --outdir artifacts/cloudflare-dry-run",
    "check:pages": "node scripts/build-cloudflare.js && wrangler pages functions build functions --outdir artifacts/pages-functions --build-output-directory dist",
    "smoke:cloudflare": "node scripts/check-cloudflare-runtime.js",
    "start": "node server/index.js",
    "preview": "node scripts/start-preview.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "check:mini": "node scripts/compile-miniprogram.js",
    "test:e2e": "node scripts/e2e-check.js",
    "qa:native": "node scripts/render-native.js",
    "assets": "node scripts/prepare-assets.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "miniprogram-compiler": "0.2.3",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "wrangler": "4.132.0"
  }
}
