page{background:#faf8f3;color:#3e4437;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:26rpx;line-height:1.6}view,button,input,textarea{box-sizing:border-box}button{font-size:26rpx;line-height:1.6;border-radius:0;margin:0;padding:0;background:transparent;color:inherit}button::after{border:none}button[disabled]{opacity:.45}input,textarea{font-size:26rpx}image{display:block} .primary{background:#e77e53;color:#fffdf6;border-radius:16rpx;font-size:26rpx;min-height:82rpx;display:flex;align-items:center;justify-content:center;letter-spacing:1rpx}.secondary{border:1rpx solid #dedfce;background:#f4f5eb;color:#8b967b;border-radius:16rpx;min-height:78rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx}.muted{color:#a0a58f}.heart{color:#d4906f}
