<view class="page heart-page">
  <view class="heart-header" style="padding-top:{{statusBar}}px"><view class="heart-header-inner"><view class="heart-brand" bindtap="switchPage" data-page="menu"><view class="heart-cloud">♥</view><view><view class="brand-title">心动菜单</view><text class="brand-caption">今天也要好好吃饭呀</text></view></view><button class="chef-button" bindtap="kitchen">👨‍🍳</button></view></view>
  <view wx:if="{{loading}}" class="loading-state"><text>🎀</text><text>把今天的好胃口，留给彼此。</text></view>
  <view wx:elif="{{error}}" class="empty"><text class="empty-title">暂时没能连接到我们的餐桌</text><text class="empty-description">{{error}}</text><button class="primary" bindtap="retry">重新连接</button></view>
  <block wx:else>
    <view wx:if="{{!connected}}" class="reconnect">连接暂时中断，正在重连。操作成功后会更新。</view>
    <block wx:if="{{page === 'menu'}}"><view class="kitty-hero"><image class="kitty-picture" src="/assets/kitty-kitchen-v2.jpg" mode="aspectFill"/><view class="hero-shade"></view><view class="kitty-copy"><text class="kitty-label">HELLO KITTY · 私房菜</text><view class="kitty-title">今天想吃什么？</view><text class="kitty-caption">宝贝点菜，我负责把喜欢端上桌</text></view></view><view class="personal-note"><text class="letter-emoji">💌</text><view><text class="note-name">小成的专属菜单：</text>不算价格，只计算心动。</view><text class="note-bow">🎀</text></view></block>
    <view class="heart-content">
      <block wx:if="{{page === 'menu' || page === 'favorites' || page === 'manage'}}">
        <button wx:if="{{page !== 'menu'}}" class="back-link" bindtap="switchPage" data-page="us">‹ 返回我们</button>
        <view class="menu-heading"><text>{{page === 'menu' ? '今天的菜单' : page === 'favorites' ? '心动收藏' : '我们的私房菜单'}}</text><text class="menu-count">{{dishes.length}} 道可选</text></view>
        <block wx:if="{{page !== 'manage'}}"><scroll-view scroll-x class="heart-categories"><view class="heart-category-inner"><button wx:for="{{foodTabs}}" wx:key="id" class="category-pill {{uiTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="foodTab">{{item.icon}} {{item.label}}</button></view></scroll-view><view class="dish-section-heading"><text>{{tabTitle}}</text><button bindtap="toggleFilter">爱心难度不是价格</button></view></block>
        <button wx:else class="primary spaced" bindtap="add">＋ 添加菜品</button>
        <view wx:if="{{filterOpen}}" class="menu-tools"><view class="search-box"><image src="/assets/search.png"/><input value="{{filters.query}}" bindinput="search" placeholder="搜索菜名、口味…"/></view><view class="filter-panel"><picker range="{{spiceFilters}}" data-type="spice" bindchange="filterChange"><view>{{filterLabels[0]}}⌄</view></picker><picker range="{{kindFilters}}" data-type="kind" bindchange="filterChange"><view>{{filterLabels[1]}}⌄</view></picker><picker range="{{priceFilters}}" data-type="price" bindchange="filterChange"><view>{{filterLabels[2]}}⌄</view></picker><button bindtap="clearFilters">清空筛选</button></view></view>
        <view class="turn-notice" wx:if="{{room.decisionMode === 'turn'}}">⇄ 这一次，听{{turnName}}的。决定后下次交换。</view>
        <view class="heart-dishes"><view wx:for="{{dishes}}" wx:key="id" class="heart-dish {{item.matched ? 'matched' : ''}}"><view class="dish-main-row"><view class="dish-thumb" bindtap="detail" data-id="{{item.id}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="imageError"/><text wx:else class="food-fallback">{{item.emoji}}</text><text class="photo-heart">♥</text></view><view class="dish-info"><view class="dish-name-button" bindtap="detail" data-id="{{item.id}}">{{item.displayName}}</view><text class="dish-description">{{item.displayDescription}}</text><view class="dish-bottom"><text>⏱ {{item.minutes}}分钟</text><text class="difficulty">{{item.hearts}}</text><text class="taste-tag">{{item.matched ? '双向心动' : item.partnerVote === 'yes' ? 'TA 爱吃' : item.vote === 'yes' ? '我想吃' : item.tags[0]}}</text></view></view><button class="dish-favorite {{item.favorite ? 'saved' : ''}}" data-id="{{item.id}}" catchtap="favorite">♥</button><button wx:if="{{page !== 'manage'}}" class="dish-add {{item.quantity ? 'has-quantity' : ''}}" data-id="{{item.id}}" data-delta="1" catchtap="cartChange">{{item.quantity || '＋'}}</button></view>
          <view wx:if="{{page === 'manage'}}" class="edit-row"><button bindtap="edit" data-id="{{item.id}}">编辑</button><button bindtap="remove" data-id="{{item.id}}">删除</button></view>
          <view wx:elif="{{expandedDish === item.id}}" class="dish-expanded"><view class="detail-meta"><text>{{item.name}}</text><text>0 元 · {{item.spiceLabel}} · {{item.kind}}</text></view><text class="detail-person">现在是{{ownName}}在选，可在「我们」切换身份</text><view class="vote-row"><button class="vote yes {{item.vote === 'yes' ? 'selected' : ''}}" bindtap="vote" data-id="{{item.id}}" data-value="yes">{{item.vote === 'yes' ? '♥ 想吃！' : '♡ 想吃'}}</button><button class="vote no {{item.vote === 'no' ? 'selected' : ''}}" bindtap="vote" data-id="{{item.id}}" data-value="no">{{item.vote === 'no' ? '已跳过' : '× 不想吃'}}</button><button class="pick-inline" bindtap="pick" data-id="{{item.id}}">就吃这道</button></view><text wx:if="{{item.partnerVote}}" class="partner-hint">{{item.partnerName}}{{item.partnerVote === 'yes' ? '也想吃这道 ♡' : '这次想换个口味'}}</text></view>
        </view></view>
        <view wx:if="{{!dishes.length}}" class="empty"><text class="empty-emoji">💗</text><text class="empty-title">{{emptyTitle}}</text><text class="empty-description">{{emptyDescription}}</text><button class="secondary" bindtap="emptyAction">去发现美味 →</button></view>
        <view class="menu-bottom-tools"><button bindtap="toggleFilter">⌕ 搜索 / 筛选</button><button bindtap="add">＋ 添加菜品</button><button bindtap="draw">⚄ 随机推荐</button></view><view class="heart-footnote">♡ 好好吃饭，慢慢相爱 · 全部菜品 0 元</view>
      </block>
      <block wx:elif="{{page === 'history'}}"><view class="page-intro"><view class="page-title">{{kitchenMode ? '今天的小厨房' : '心动订单'}}</view><text>{{kitchenMode ? '用心做饭，把喜欢准时端上桌。' : '每一次认真吃饭，都是我们的小纪念'}}</text></view><view class="order-card" wx:for="{{orders}}" wx:for-item="order" wx:key="id"><view class="order-header"><view><view class="order-title">心动单号 {{order.number}}</view><text>{{order.date}} · {{order.quantity}} 份</text></view><view class="order-header-actions"><text class="order-status">{{order.statusLabel}}</text><button class="order-delete" bindtap="deleteOrder" data-id="{{order.id}}">删除</button></view></view><view class="order-body"><view class="order-items"><text wx:for="{{order.items}}" wx:for-item="entry" wx:key="id">{{entry.dish.emoji}} {{entry.dish.name}} × {{entry.quantity}}</text></view><view class="order-note">{{order.note}}</view><view class="order-progress"><view wx:for="{{order.steps}}" wx:for-item="step" wx:key="index" class="order-step {{step.done ? 'done' : ''}}"><view wx:if="{{step.index !== 3}}" class="step-line {{step.line ? 'line-done' : ''}}"></view><view class="step-dot"></view><text>{{step.label}}</text></view></view><button wx:if="{{kitchenMode && order.status !== 3}}" class="primary order-advance" bindtap="orderStatus" data-id="{{order.id}}" data-status="{{order.nextStatus}}">👨‍🍳 标记为{{order.nextLabel}}</button></view></view><view wx:if="{{!orders.length}}" class="empty"><text class="empty-emoji">🧾</text><text class="empty-title">第一份心动，等你下单</text><text class="empty-description">在菜单里选好喜欢的菜，我们就开始记录。</text><button class="secondary" bindtap="switchPage" data-page="menu">去点菜</button></view></block>
      <block wx:elif="{{page === 'cart'}}"><view class="page-intro"><view class="page-title">已选的小心动</view><text>喜欢的都装进来，这一餐听我们的。</text></view><block wx:if="{{cartItems.length}}"><view class="cart-item" wx:for="{{cartItems}}" wx:key="id"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><text wx:else class="cart-emoji">{{item.emoji}}</text><view class="cart-info"><view>{{item.name}}</view><text>0 元 · {{spiceOptions[item.spice]}}</text><text wx:if="{{item.conflict}}" class="cart-conflict">有一位暂时不想吃，请先移除或调整</text></view><view class="quantity-control"><button bindtap="cartChange" data-id="{{item.id}}" data-delta="-1">−</button><text>{{item.quantity}}</text><button bindtap="cartChange" data-id="{{item.id}}" data-delta="1">＋</button></view></view><view class="checkout-card"><view>💌 给大厨的小纸条</view><textarea value="{{orderNote}}" bindinput="noteInput" maxlength="120" placeholder="例如：不要辣 · 现在开始"/><view class="checkout-total"><text>共 {{cartCount}} 份心动</text><text>合计 0 元</text></view><button class="primary" bindtap="checkout" disabled="{{saving}}" loading="{{saving}}">🎀 就这些，交给大厨</button></view></block><view wx:else class="empty"><text class="empty-emoji">🛒</text><text class="empty-title">小餐篮还空着呢</text><text class="empty-description">点一下菜品旁的加号，把喜欢装进来。</text><button class="secondary" bindtap="switchPage" data-page="menu">去挑几道菜</button></view></block>
      <view wx:elif="{{page === 'us'}}" class="us-page"><view class="page-intro"><view class="page-title">我们的心动日常</view><text>一人点菜，一人下厨，两个人好好吃饭。</text></view><view class="us-shortcuts"><button bindtap="switchPage" data-page="favorites">♥<text>心动收藏</text></button><button bindtap="switchPage" data-page="manage">📖<text>私房菜单</text></button><button bindtap="profile">💌<text>我们的昵称</text></button></view>
            <view class="room-panel" wx:if="{{page !== 'history' && page !== 'manage'}}">
      <view class="room-copy"><view class="room-heading">我们的餐桌<text class="status"><text class="status-dot">●</text> {{modeText}}</text></view><text class="room-hint">{{room.mode === 'together' ? '现在是' + ownName + '在选 · 轻点头像切换' : '各自选菜 · 选择自动同步'}}</text><button class="invite-link" bindtap="invite">↗ {{room.mode === 'together' ? '邀请另一半，一起远程选' : '邀请码 ' + room.code + ' · 邀请 / 加入'}}</button></view>
      <view class="people"><block wx:for="{{people}}" wx:key="id"><text wx:if="{{index === 1}}" class="between-heart">♡</text><button class="person {{item.active ? 'active' : ''}}" data-person="{{item.id}}" bindtap="switchPerson"><view class="avatar {{item.id === 'b' ? 'sage' : ''}}">{{item.avatar}}<text wx:if="{{item.active}}" class="avatar-check">✓</text></view><text class="person-name">{{item.name}}</text><text class="person-count">{{item.count}} 道想吃</text></button></block></view>
    </view>
    <view class="match-panel" wx:if="{{page !== 'history' && page !== 'manage'}}"><view class="panel-heading"><text>♡ 我们的双向心动</text><text class="count-badge">{{matched.length}}</text></view><text class="match-description">{{matched.length ? '原来，我们的胃口这么合拍。' : '两个人都想吃的美味，会在这里相遇。'}}</text><scroll-view wx:if="{{matched.length}}" scroll-x class="match-scroll"><view class="match-items"><view class="match-item" wx:for="{{matched}}" wx:key="id"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><text wx:else class="match-emoji">{{item.emoji}}</text><view><text class="match-name">{{item.name}}</text><text class="match-price">默契 +1 · ¥{{item.price}}</text></view><button bindtap="pick" data-id="{{item.id}}">就吃它</button></view></view></scroll-view><view wx:else class="match-empty"><text class="empty-hearts">♡♡</text><view><text>心动正在发生…</text><text class="match-small">各自选选，看看会有什么默契</text></view></view><view wx:if="{{!matched.length}}" class="quick-decide"><button bindtap="draw">⚄ 随机推荐</button><button bindtap="turn">⇄ {{room.decisionMode === 'turn' ? '切换随机模式' : '轮流来决定'}}</button></view></view>

        <button class="primary spaced" bindtap="draw">⚄ 今天吃什么，摇一下</button><button class="text-link" bindtap="turn">⇄ {{room.decisionMode === 'turn' ? '切换回随机推荐' : '或者，轮流来决定'}}</button><button class="text-link" bindtap="about">怎么一起点菜？</button>
      </view>
    </view>
    <view class="heart-tabbar"><button wx:for="{{navs}}" wx:key="id" class="heart-tab {{page === item.id || item.id === 'us' && (page === 'favorites' || page === 'manage') ? 'active' : ''}} {{item.id === 'cart' ? 'cart-tab' : ''}}" data-page="{{item.id}}" bindtap="switchPage"><view class="tab-symbol">{{item.emoji}}<text wx:if="{{item.id === 'history' && orderCount}}" class="tab-count">{{orderCount}}</text><text wx:if="{{item.id === 'cart' && cartCount}}" class="tab-count">{{cartCount}}</text></view><text>{{item.label}}</text></button></view>
  </block>
    <view class="sheet-mask" wx:if="{{modal}}" catchtap="close"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><button class="sheet-close" bindtap="close">×</button><scroll-view scroll-y class="sheet-scroll">
    <view wx:if="{{modal === 'invite'}}" class="sheet-body"><text class="sheet-eyebrow">SAVE A SEAT FOR YOUR LOVE</text><text class="sheet-title">这张餐桌，就差你啦</text><text class="sheet-description">发给另一半。即使隔着距离，也能实时看见彼此想吃的菜。</text><view class="room-code">{{room.code}}</view><button class="primary spaced" open-type="share">♡ 邀请另一半，一起选菜</button><button class="secondary spaced" bindtap="copyCode">复制邀请码</button><text class="invite-note">房间仅限两位 · {{room.joined ? '另一位已加入' : '等待另一位加入'}}</text><view class="divider">已有另一半的邀请码？</view><input class="form-control join-input" maxlength="8" placeholder="输入 8 位邀请码" value="{{joinCode}}" bindinput="joinInput"/><button class="secondary spaced" bindtap="join" loading="{{saving}}" disabled="{{saving}}">加入 TA 的餐桌</button><button wx:if="{{role === 'a'}}" class="text-link" bindtap="together">切换为面对面点菜 →</button></view>
    <view wx:elif="{{modal === 'dish'}}" class="sheet-body"><text class="sheet-eyebrow">OUR LITTLE SECRET MENU</text><text class="sheet-title">{{editingId ? '编辑这道小心动' : '添一道我们的私房菜'}}</text><text class="sheet-description">家里的拿手菜，也值得被认真期待。</text><view class="emoji-picker"><button wx:for="{{emojis}}" wx:key="*this" class="{{form.emoji === item ? 'selected' : ''}}" data-emoji="{{item}}" bindtap="emoji">{{item}}</button></view><view class="form-field"><text>菜品名称</text><input class="form-control" maxlength="24" value="{{form.name}}" data-field="name" bindinput="formInput" placeholder="比如：TA 最爱的红烧排骨"/></view><view class="form-field"><text>一句话描述</text><textarea class="form-control description-input" maxlength="80" value="{{form.desc}}" data-field="desc" bindinput="formInput" placeholder="这道菜，有什么特别的小故事？"/></view><view class="form-grid"><view class="form-field"><text>参考价格（元）</text><input type="digit" class="form-control" value="0" disabled/></view><view class="form-field"><text>辣度</text><picker range="{{spiceOptions}}" value="{{form.spice}}" data-field="spice" bindchange="formSelect"><view class="form-control">{{spiceOptions[form.spice]}} ⌄</view></picker></view><view class="form-field"><text>荤素</text><picker range="{{kindOptions}}" value="{{formKindIndex}}" data-field="kind" bindchange="formSelect"><view class="form-control">{{form.kind}} ⌄</view></picker></view><view class="form-field"><text>分类</text><picker range="{{dishCategories}}" value="{{formCategoryIndex}}" data-field="category" bindchange="formSelect"><view class="form-control">{{form.category}} ⌄</view></picker></view></view><button class="primary spaced" bindtap="saveDish" loading="{{saving}}" disabled="{{saving}}">{{editingId ? '保存修改' : '＋ 加入我们的菜单'}}</button></view>
    <view wx:elif="{{modal === 'draw' && pending}}" class="sheet-body draw-sheet"><text class="sheet-eyebrow">A DELICIOUS LITTLE SURPRISE</text><text class="sheet-title">今天，就让它温暖我们</text><image wx:if="{{pending.dish.image}}" class="draw-image" src="{{pending.dish.image}}" mode="aspectFill"/><view wx:else class="draw-fallback">{{pending.dish.emoji}}</view><text class="draw-name">{{pending.dish.name}}</text><text class="draw-description">{{pending.dish.desc}}</text><text class="draw-meta">¥{{pending.dish.price}} · {{pending.spiceLabel}} · {{pending.dish.kind}}</text><text class="draw-hint">已避开任意一方不想吃的菜</text><button class="primary spaced" bindtap="confirm" loading="{{saving}}" disabled="{{saving}}">✓ 就吃它，开饭啦</button><button class="secondary spaced" bindtap="draw" loading="{{drawing}}" disabled="{{drawing}}">⚄ 再来一道小惊喜</button></view>
    <view wx:elif="{{modal === 'profile'}}" class="sheet-body"><text class="sheet-eyebrow">HELLO, MY FAVORITE PERSON</text><text class="sheet-title">今天，怎么称呼你？</text><text class="sheet-description">起一个亲切的小昵称，让每一餐更有温度。</text><view class="form-field"><text>昵称</text><input class="form-control" maxlength="12" value="{{nickname}}" bindinput="nicknameInput"/></view><button class="primary spaced" bindtap="saveName">保存昵称</button><button class="secondary spaced" bindtap="invite">邀请 / 加入餐桌</button><button class="text-link" bindtap="reset">开始新一轮点菜 →</button><button class="text-link" bindtap="about">怎么一起点菜？ →</button><button class="text-link" bindtap="newRoom">创建新的餐桌 →</button></view>
    <view wx:else class="sheet-body"><text class="sheet-eyebrow">A TABLE FOR TWO</text><text class="sheet-title">一餐两人，刚好是我们</text><text class="sheet-description">把选择的纠结，变成两个人的小默契。</text><view class="help-step"><text>01 · 各自选选</text><view>轻点「想吃」或「不想吃」。面对面时点头像切换，远程时邀请另一半加入。</view></view><view class="help-step"><text>02 · 发现默契</text><view>两个人都想吃的菜，会自动高亮在「双向心动」。</view></view><view class="help-step"><text>03 · 一起开饭</text><view>直接选心动菜、随机摇一道，或轮流决定。确认后自动记录这一餐。</view></view><button class="primary spaced" bindtap="close">开始我们的一餐</button></view>
  </scroll-view></view></view>

</view>
